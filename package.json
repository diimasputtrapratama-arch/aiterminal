    "web": "npm run dev --workspace=@att/web"
  },
  "dependencies": { "@prisma/client": "^5.22.0", "tsx": "^4.19.0" },
  "devDependencies": { "prisma": "^5.22.0", "typescript": "^5.6.0", "@types/node": "^22.0.0" },
  "engines": { "node": ">=20" }
}
