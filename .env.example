# ===== Wajib (web & worker) =====
DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require
# Kunci enkripsi API key pengguna. WAJIB sama di web & worker. Acak, >=32 karakter. JANGAN diganti setelah dipakai.
MASTER_KEY=
# Hanya web: penanda tangan sesi login, acak >=32 karakter
SESSION_SECRET=

# ===== Opsional =====
ALLOW_REGISTER=true        # set false setelah akun Anda dibuat
# Fallback RPC jika belum diisi di dashboard (biasanya dikosongkan; isi lewat menu Pengaturan)
SOLANA_RPC_URL=
SOLANA_WS_URL=
# Saklar global LIVE (worker). Biarkan false sampai paper trading + pengujian selesai.
ALLOW_LIVE=false
